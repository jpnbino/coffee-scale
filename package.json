{
  "name": "coffee-scale-controller",
  "private": true,
  "description": "Open-hardware coffee scale controller: KiCad design, release tooling and review portal",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node release.mjs --validate-only",
    "release": "node release.mjs",
    "release:strict": "node release.mjs --require-assembly-ready",
    "preview": "node preview.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
